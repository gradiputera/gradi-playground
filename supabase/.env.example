# Copy to supabase/.env for local development. Never commit supabase/.env.
# The Supabase CLI reads these for the env(...) references in config.toml.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI for local development: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# Cloudflare Turnstile secret. Captcha is disabled locally; only needed if you enable it in config.toml.
SUPABASE_AUTH_CAPTCHA_SECRET=<turnstile-secret-key>
