    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "jose": "6.2.18",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
