{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Consumes payment events through signed webhooks and sends sandbox email for gradi-playground.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "node src/main.ts",
